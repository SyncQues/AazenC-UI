# Hoisted node_modules. Vercel depends on this.
#
# `vercel.json` declares `"framework": "nextjs"` at the REPO ROOT, so the
# Vercel CLI resolves Next.js from the root `node_modules`. The app itself
# lives in `apps/playground`, so with pnpm's default isolated linker `next`
# is only linked into `apps/playground/node_modules` and the build aborts
# with "No Next.js version detected".
#
# Historically this was for Expo/React Native, which also needed a flat
# layout. Those packages are gone, but hoisting is now load-bearing for
# deploys — removing this file breaks every Deploy Preview and Production
# run. Do not delete it without reworking vercel.json first.
node-linker=hoisted
